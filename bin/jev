#!/usr/bin/env python3
"""
jev — typed decisions from TypeSafe's Jev model, with a deterministic fallback.

WHAT THIS IS FOR. Several decisions in this repo are currently made by a regex
standing in for judgement:

  * is this shell command safe to run?        (CATASTROPHIC in llm-agent)
  * did the agent ask a question instead of
    building the thing?                       (ASKED_A_QUESTION in llm-agent)
  * is this run actually finished, or did it
    give up?                                  (the whip's edits+elapsed test)
  * does this task need the 30B, or will a
    small model do?                           (nothing — currently always 30B)

A regex cannot tell `rm -rf ./build` from `rm -rf "$BUILD_DIR"` where the
variable is unset. A full LLM call can, but costs seconds and dollars at a
point in the loop that must be fast. Jev sits exactly there: ~150ms, typed
output, priced per million input tokens with output free.

WHAT THIS IS NOT. Not a chat model and not a fallback brain. Ask it closed
questions with enumerated answers. If you want prose, you want the local model.

OFFLINE IS THE POINT. This project exists so you can work with no network. So:
every call has a deterministic fallback, the fallback is what runs when there
is no key or no connection, and `used` in the result always tells you which
one answered. A Jev outage must never change what this tool is willing to do —
it may only change how well it judges.

  export OPENROUTER_API_KEY=...        # required for live decisions
  jev choice  "state" --options a,b,c --instructions "..."
  jev noul    "state" --instructions "is the work complete?"
  jev score   "state" --instructions "how risky, 0-10?"
  jev --selftest                       # prove the fallbacks work with no key

Python 3.9 compatible.
"""

import argparse
import hashlib
import json
import os
import pathlib
import sys
import time
import urllib.error
import urllib.request

ENDPOINT = "https://openrouter.ai/api/alpha/decisions"
MODEL = os.environ.get("JEV_MODEL", "typesafe/jev-1.13")
TIMEOUT = float(os.environ.get("JEV_TIMEOUT", "4"))

# Decisions are deterministic for a given (state, question). Caching them turns
# a repeat decision into a disk read, which matters for "preload": you can warm
# the cache for a queue of work before any of it runs.
CACHE = pathlib.Path(os.environ.get(
    "JEV_CACHE", str(pathlib.Path.home() / ".cache" / "jev")))


def available():
    return bool(os.environ.get("OPENROUTER_API_KEY"))


def _key(payload):
    return hashlib.sha256(
        json.dumps(payload, sort_keys=True).encode()).hexdigest()[:24]


def _cached(k):
    f = CACHE / (k + ".json")
    if not f.exists():
        return None
    try:
        return json.loads(f.read_text())
    except Exception:
        return None


def _store(k, value):
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        (CACHE / (k + ".json")).write_text(json.dumps(value))
    except Exception:
        pass                                   # a cache failure is never fatal


def ask(state, questions, use_cache=True):
    """Return (answers, used). `used` is 'jev', 'cache', or a failure reason."""
    payload = {"model": MODEL, "state": state, "questions": questions}
    k = _key(payload)

    if use_cache:
        hit = _cached(k)
        if hit is not None:
            return hit, "cache"

    if not available():
        return None, "no-key"

    req = urllib.request.Request(
        ENDPOINT,
        data=json.dumps(payload).encode(),
        headers={
            "Authorization": "Bearer " + os.environ["OPENROUTER_API_KEY"],
            "Content-Type": "application/json",
        })
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            answers = json.load(r).get("answers", {})
    except urllib.error.HTTPError as e:
        return None, "http-{}".format(e.code)
    except Exception as e:
        # Offline, slow, DNS down — all the same to the caller: fall back.
        return None, type(e).__name__.lower()

    _store(k, answers)
    return answers, "jev"


# ── the three primitives ───────────────────────────────────────────────────

def choice(state, name, instructions, criteria, fallback=None):
    """Pick one key from `criteria`. Returns (key, confidence, used)."""
    answers, used = ask(state, {name: {
        "type": "choice", "instructions": instructions, "criteria": criteria}})
    if answers is None:
        return fallback, 0.0, used
    a = answers.get(name, {})
    return a.get("choice", fallback), a.get("confidence", 0.0), used


def noul(state, name, instructions, fallback=None):
    """Probability 0-1 that the statement is true. Returns (value, used)."""
    answers, used = ask(state, {name: {
        "type": "noul", "instructions": instructions}})
    if answers is None:
        return fallback, used
    a = answers.get(name, {})
    v = a.get("noul")
    return (v if v is not None else fallback), used


def score(state, name, instructions, fallback=None):
    """Numeric judgement. Returns (value, used)."""
    answers, used = ask(state, {name: {
        "type": "score", "instructions": instructions}})
    if answers is None:
        return fallback, used
    a = answers.get(name, {})
    v = a.get("score")
    return (v if v is not None else fallback), used


# ── the decisions this repo actually makes ─────────────────────────────────
# Kept here, not inline at the call sites, so the question wording is one
# definition. A prompt copied into two files drifts exactly like a rule does.

def judge_command(cmd, regex_verdict):
    """safe | destructive | catastrophic.

    `regex_verdict` is what CATASTROPHIC already decided. Jev may ESCALATE a
    command the regex waved through, but never de-escalates one the regex
    caught: a pattern match is evidence, and a probabilistic model should not
    be able to talk the guard out of a known-bad command.
    """
    verdict, conf, used = choice(
        cmd,
        "danger",
        "A local LLM agent wants to run this shell command on a developer's "
        "Mac. Classify the WORST plausible outcome if it runs as written, "
        "assuming any referenced variable may be empty or unset.",
        {
            "safe": "Reads, inspects, builds, or writes inside a project. "
                    "Reversible or trivially re-done.",
            "destructive": "Deletes or overwrites real work, force-pushes, "
                           "drops data. Recoverable only from backups.",
            "catastrophic": "Damages the machine or the user's whole account: "
                            "wipes a disk, erases home, fork bomb, shutdown.",
        },
        fallback=regex_verdict)
    if regex_verdict == "catastrophic":
        return "catastrophic", 1.0, "regex-override"
    return verdict, conf, used


def judge_finished(summary, regex_said_question):
    """Did this run finish the job, or hand the decision back?

    The whip currently infers this from "edited files AND under the time
    floor", which cannot tell "done early because it was a small job" from
    "gave up and asked a question". That is why it misfires.
    """
    verdict, conf, used = choice(
        summary,
        "completion",
        "An autonomous coding agent produced this closing message. Decide "
        "what it actually did.",
        {
            "finished": "Completed the task and reported concrete results.",
            "asked": "Stopped to ask a clarifying question instead of "
                     "choosing a reasonable interpretation and building.",
            "partial": "Did some of the work, then stopped with known work "
                       "outstanding, without being blocked.",
            "blocked": "Genuinely cannot continue without a human decision, "
                       "credential, or access it does not have.",
        },
        fallback=("asked" if regex_said_question else "finished"))
    return verdict, conf, used


def judge_model_size(task):
    """Which local model does this task actually need?

    Loading an 18GB MoE to rename a variable costs ~20s and most of the RAM on
    a 36GB machine.
    """
    return choice(
        task,
        "size",
        "Decide the smallest local model class that can complete this coding "
        "task correctly on the first attempt.",
        {
            "small": "Mechanical and local: rename, reformat, a one-line fix, "
                     "a regex, a single obvious edit.",
            "large": "Needs real reasoning, multi-file changes, architecture "
                     "decisions, or reliable multi-step tool use.",
        },
        fallback="large")          # when unsure, the capable model. Wrong-small
                                   # wastes a whole run; wrong-large wastes RAM.


# ── cli ────────────────────────────────────────────────────────────────────

def selftest():
    """Prove every decision still returns a usable answer with no key."""
    saved = os.environ.pop("OPENROUTER_API_KEY", None)
    os.environ["JEV_CACHE"] = "/tmp/jev-selftest-cache"
    print("jev fallback self-test (no key, no network needed)\n")
    results = []

    def check(name, got, want):
        ok = got == want
        results.append(ok)
        print("  {}  {:<34} → {}".format(
            "\033[32mPASS\033[0m" if ok else "\033[31mFAIL\033[0m", name, got))

    v, _, used = judge_command("rm -rf /", "catastrophic")
    check("catastrophic cmd, no key", v, "catastrophic")
    check("  …and it was the regex", used, "regex-override")

    v, _, _ = judge_command("npm run build", "safe")
    check("safe cmd falls back to regex", v, "safe")

    v, _, _ = judge_finished("I've created the file.", False)
    check("finished, no key", v, "finished")
    v, _, _ = judge_finished("Could you provide more details?", True)
    check("asked, no key", v, "asked")

    v, _, _ = judge_model_size("rename a variable")
    check("model size defaults to large", v, "large")

    print("\n  availability: {}".format(
        "key present" if available() else "NO KEY — fallbacks in use"))
    if saved:
        os.environ["OPENROUTER_API_KEY"] = saved
    print("\n{}/{} passed".format(sum(results), len(results)))
    return 0 if all(results) else 1


def main():
    ap = argparse.ArgumentParser(description="Typed decisions via Jev.")
    ap.add_argument("primitive", nargs="?",
                    choices=["choice", "noul", "score", "status"])
    ap.add_argument("state", nargs="?")
    ap.add_argument("--instructions", default="")
    ap.add_argument("--options", default="", help="comma-separated, for choice")
    ap.add_argument("--name", default="q")
    ap.add_argument("--no-cache", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()

    if a.selftest:
        return selftest()

    if a.primitive == "status" or not a.primitive:
        print("endpoint  {}".format(ENDPOINT))
        print("model     {}".format(MODEL))
        print("key       {}".format("present" if available() else "MISSING"))
        print("cache     {} ({} entries)".format(
            CACHE, len(list(CACHE.glob("*.json"))) if CACHE.exists() else 0))
        if not available():
            print("\nNo OPENROUTER_API_KEY. Every decision falls back to its")
            print("deterministic rule — nothing breaks, judgement is coarser.")
            print("  export OPENROUTER_API_KEY=...")
        return 0

    if not a.state:
        sys.exit("a state to judge is required")

    t0 = time.time()
    if a.primitive == "choice":
        opts = [o.strip() for o in a.options.split(",") if o.strip()]
        if not opts:
            sys.exit("--options is required for a choice")
        v, conf, used = choice(a.state, a.name, a.instructions,
                               {o: o for o in opts})
        out = {"choice": v, "confidence": conf}
    elif a.primitive == "noul":
        v, used = noul(a.state, a.name, a.instructions)
        out = {"noul": v}
    else:
        v, used = score(a.state, a.name, a.instructions)
        out = {"score": v}

    out["used"] = used
    out["ms"] = int((time.time() - t0) * 1000)
    print(json.dumps(out, indent=2))
    return 0 if out.get(a.primitive) is not None else 1


if __name__ == "__main__":
    sys.exit(main())
