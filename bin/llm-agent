#!/usr/bin/env python3
"""
llm-agent — an agentic loop over a local llama.cpp server, optionally whipped.

llama-server is a stateless completion API: no turns, no Stop event, nothing for a
Claude Code hook to intercept. This supplies the missing piece — a loop that has a
concept of "the model is trying to finish" — and then hands that moment to the EXACT
SAME ~/.claude/hooks/whip-it-good.sh that governs Claude Code.

The hook is not reimplemented or copied here. It is invoked with the same JSON
contract (session_id + transcript_path, event "start" / "stop"), so there is one
definition of the rule and sharpening it in one place sharpens it everywhere.
See Aidxn-Context/halls/code-standards.md — never fork a source of truth.

Usage
  llm-agent "task"                        plain agentic loop
  llm-agent --whip "task"                 arm Whip-It-Good for this run
  llm-agent --whip --whip-minutes 10 "…"  shorter floor for local-model speeds
  llm-agent --verify "task"               run the project's tests before finishing
  llm-agent --rules code,comms "task"     load specific halls as system prompt
  llm-agent --port 8081 "task"            a different llama-server
  llm-agent --port 11434 --model qwen3-coder:30b "task"   via ollama (unloads when idle)

Arming matches the real hook: --whip literally puts "whip it good" in the prompt the
hook sees, so the same string match that arms a Claude Code session arms this one.

Tools given to the model: list_dir, read_file, write_file, edit_file, bash.
Writes are confined to --workdir (default: cwd). bash is allowlisted unless --yolo.
"""

import argparse
import datetime as dt
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request
import uuid

HOOK = pathlib.Path.home() / ".claude" / "hooks" / "whip-it-good.sh"
CONTEXT = pathlib.Path.home() / "Desktop" / "00 - Aidxn" / "Aidxn-Context"

HALL_ALIASES = {
    "code": "code-standards",
    "comms": "comms-and-tone",
    "git": "git-and-deploys",
    "design": "design-standards",
    "data": "data-db-safety",
    "research": "research-standards",
    "loop": "agent-loop-discipline",
    "brand": "brand-and-voice",
    "tooling": "tooling-and-estate",
}

# bash commands allowed without --yolo. Read-only / inspection only.
SAFE_BASH = re.compile(
    r"^\s*(ls|cat|head|tail|wc|grep|rg|find|file|stat|du|df|pwd|echo|which|"
    r"git\s+(status|log|diff|show|branch\s*$)|python3?\s+-c|node\s+-e|"
    r"npm\s+(run\s+(build|test|lint)|ls)|pytest|jq|sed\s+-n)\b"
)


# ─────────────────────────────── transcript ────────────────────────────────
# whip-it-good.sh decides "was this a work turn?" by counting Edit/Write tool_use
# blocks in a JSONL transcript newer than the turn's start stamp. Emit that shape.

class Transcript:
    def __init__(self, session_id):
        d = pathlib.Path("/tmp/llm-agent-transcripts")
        d.mkdir(parents=True, exist_ok=True)
        self.path = d / f"{session_id}.jsonl"
        self.path.write_text("")

    def tool_use(self, name):
        rec = {
            "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
            "message": {"content": [{"type": "tool_use", "name": name}]},
        }
        with self.path.open("a") as fh:
            fh.write(json.dumps(rec) + "\n")


# ───────────────────────────────── the hook ────────────────────────────────

def hook(event, payload):
    """Call the real whip-it-good.sh. Returns its block reason, or None."""
    if not HOOK.exists():
        return None
    try:
        p = subprocess.run(
            ["bash", str(HOOK), event],
            input=json.dumps(payload),
            capture_output=True, text=True, timeout=20,
        )
    except Exception:
        return None                       # fail open, exactly as the hook does
    out = (p.stdout or "").strip()
    if not out:
        return None
    try:
        return json.loads(out).get("reason")
    except Exception:
        return None


# ───────────────────────────────── tools ───────────────────────────────────

TOOLS = [
    {"type": "function", "function": {
        "name": "list_dir", "description": "List files in a directory.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}}, "required": ["path"]}}},
    {"type": "function", "function": {
        "name": "read_file", "description": "Read a file's contents.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}}, "required": ["path"]}}},
    {"type": "function", "function": {
        "name": "write_file", "description": "Write (or overwrite) a file.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}, "content": {"type": "string"}},
            "required": ["path", "content"]}}},
    {"type": "function", "function": {
        "name": "edit_file",
        "description": "Replace an exact string in a file. old must appear exactly once.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}, "old": {"type": "string"},
            "new": {"type": "string"}}, "required": ["path", "old", "new"]}}},
    {"type": "function", "function": {
        "name": "bash", "description": "Run a shell command and return its output.",
        "parameters": {"type": "object", "properties": {
            "command": {"type": "string"}}, "required": ["command"]}}},
]

WRITERS = {"write_file", "edit_file"}

# "it ended by asking instead of building" — deliberately narrow so a report that
# merely contains a question mark does not trip it.
ASKED_A_QUESTION = re.compile(
    r"(could you (provide|clarify|confirm|specify)|can you (provide|clarify|confirm|specify)"
    r"|what (kind|sort|type) of|which (one|option|approach)|would you like"
    r"|do you want|let me know|please (provide|clarify|specify|confirm)"
    r"|more (details|information|context)|shall I|should I)",
    re.I)


# ─────────────────── text-format tool-call recovery ────────────────────────
# Qwen-family templates fall back to emitting tool calls as TEXT whenever the
# server's tool definitions go missing from the rendered prompt — which ollama's
# qwen3-coder template does as soon as there is `tool` role history. The loop then
# sees no tool_calls, treats it as a final answer, and the model reports success for
# work it never did. Measured 2026-11-02: step 1 structured, step 2 text.
#
# Rather than fight the template, parse the text form too. A tool call the harness
# can see is a tool call that actually runs; anything else is fiction.
#
#   <function=write_file>
#   <parameter=path>
#   hello.py
#   </parameter>
#   <parameter=content>
#   print("hi")
#   </parameter>
#   </function>

_FN_BLOCK = re.compile(r"<function=([A-Za-z0-9_]+)>(.*?)(?:</function>|\Z)", re.S)
_PARAM = re.compile(r"<parameter=([A-Za-z0-9_]+)>\n?(.*?)\n?</parameter>", re.S)


def recover_text_tool_calls(content):
    """Return OpenAI-shaped tool_calls parsed out of a text response, or []."""
    if not content or "<function=" not in content:
        return []
    out = []
    for i, m in enumerate(_FN_BLOCK.finditer(content)):
        name, body = m.group(1), m.group(2)
        args = {k: v for k, v in _PARAM.findall(body)}
        if not args:                      # also accept a bare JSON body
            try:
                args = json.loads(body.strip())
            except Exception:
                args = {}
        out.append({"id": f"recovered_{i}", "type": "function",
                    "function": {"name": name, "arguments": json.dumps(args)}})
    return out


# ────────────────────────────── verification ───────────────────────────────
# The whip makes a local model keep going. It does NOT make it correct. Measured
# 2026-11-02: a whipped run wrote test_app.py asserting the route returns
# 'Hello, World!', was pushed to keep improving, changed the route to return a
# longer string, never updated the test — then reported "all files have been
# verified and are in place". Nothing had been run.
#
# So run it. If the work produced tests, they have to pass before the run is allowed
# to finish; a failure goes back to the model as the next task.

def detect_test_command(workdir):
    """Return (argv, label) for this project's tests, or None."""
    if list(workdir.glob("test_*.py")) or list(workdir.glob("*_test.py")) \
            or (workdir / "tests").is_dir():
        return ([sys.executable, "-m", "pytest", "-q"], "pytest")
    pkg = workdir / "package.json"
    if pkg.exists():
        try:
            if "test" in (json.loads(pkg.read_text()).get("scripts") or {}):
                return (["npm", "test", "--silent"], "npm test")
        except Exception:
            pass
    return None


def run_verification(workdir):
    """Run the project's tests. Returns (ok, label, output). ok=True if none found."""
    found = detect_test_command(workdir)
    if not found:
        return True, None, ""
    argv, label = found
    try:
        p = subprocess.run(argv, cwd=workdir, capture_output=True, text=True,
                           timeout=300)
    except Exception as e:
        return False, label, f"could not run {label}: {e}"
    out = ((p.stdout or "") + (p.stderr or ""))[-4000:]
    return p.returncode == 0, label, out


def run_tool(name, args, workdir, yolo, transcript):
    def resolve(p):
        q = (workdir / p).resolve() if not os.path.isabs(p) else pathlib.Path(p).resolve()
        if name in WRITERS and workdir not in q.parents and q != workdir:
            raise PermissionError(f"writes confined to {workdir}")
        return q

    try:
        if name == "list_dir":
            q = resolve(args["path"])
            return "\n".join(sorted(x.name + ("/" if x.is_dir() else "")
                                    for x in q.iterdir())) or "(empty)"

        if name == "read_file":
            return resolve(args["path"]).read_text()[:40000]

        if name == "write_file":
            q = resolve(args["path"])
            q.parent.mkdir(parents=True, exist_ok=True)
            q.write_text(args["content"])
            transcript.tool_use("Write")
            return f"wrote {q} ({len(args['content'])} bytes)"

        if name == "edit_file":
            q = resolve(args["path"])
            s = q.read_text()
            if s.count(args["old"]) != 1:
                return f"ERROR: old string appears {s.count(args['old'])} times, need exactly 1"
            q.write_text(s.replace(args["old"], args["new"]))
            transcript.tool_use("Edit")
            return f"edited {q}"

        if name == "bash":
            cmd = args["command"]
            if not yolo and not SAFE_BASH.match(cmd):
                return ("REFUSED: not on the read-only allowlist. Re-run llm-agent "
                        "with --yolo to permit arbitrary shell, or use read_file / "
                        "write_file / edit_file instead.")
            p = subprocess.run(cmd, shell=True, cwd=workdir,
                               capture_output=True, text=True, timeout=120)
            return ((p.stdout or "") + (p.stderr or ""))[:20000] or f"(exit {p.returncode})"

    except Exception as e:
        return f"ERROR: {type(e).__name__}: {e}"
    return f"ERROR: unknown tool {name}"


# ───────────────────────────── system prompt ───────────────────────────────

BUILD_NOW = (
    "You are a coding agent working on Aiden Wood's machine.\n\n"
    "NEVER ask a clarifying question. Aiden briefs in one short line and expects a "
    "working V1, not a questionnaire. If the task is underspecified, choose the most "
    "reasonable interpretation, BUILD IT, and state the assumption you made in one "
    "line at the end.\n\n"
    "Use the tools. Do not describe what you would do — do it. A response that "
    "explains a plan without calling a tool is a failure.\n\n"
    "Keep working until the task is actually finished: the files exist, and anything "
    "the work obviously implies (a test, a README, the sibling file needing the same "
    "edit) is done too."
)


def system_prompt(rules):
    parts = [BUILD_NOW]
    if rules:
        for key in rules:
            name = HALL_ALIASES.get(key.strip(), key.strip())
            f = CONTEXT / "halls" / f"{name}.md"
            if f.exists():
                parts.append(f"\n\n# RULES — {name}\n\n{f.read_text()}")
            else:
                print(f"  ! no hall '{name}' — skipping", file=sys.stderr)
    return "".join(parts)


# ────────────────────────────────── loop ───────────────────────────────────

def chat(port, messages, model=None, use_tools=True):
    # Ollama (:11434) requires a "model" field; llama-server ignores it. Sending it
    # when known keeps one code path for both backends.
    body = {"messages": messages, "max_tokens": 2048}
    if model:
        body["model"] = model
    if use_tools:
        body["tools"] = TOOLS
    req = urllib.request.Request(
        f"http://localhost:{port}/v1/chat/completions",
        data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            return json.load(r)["choices"][0]["message"]
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="ignore")[:300]
        if "model" in detail and port == 11434:
            sys.exit(f"ollama needs --model (e.g. --model qwen3-coder:30b)\n{detail}")
        sys.exit(f"backend error on :{port} — {detail}\n\n"
                 "If this is llama-server reporting 'Compute error', it is out of memory: "
                 "check for orphaned `llama-` processes holding models wired "
                 "(ps -Ao pid,etime,rss,args | grep llama-), or use --port 11434 "
                 "to route through ollama, which unloads idle models.")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach a server on :{port}. Start one with `llm serve <model>` "
                 f"(:8080) or `ollama serve` (:11434).  ({e})")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("task")
    ap.add_argument("--whip", action="store_true",
                    help="arm Whip-It-Good: refuse to finish a work run early")
    ap.add_argument("--whip-minutes", type=int, default=10,
                    help="minimum work-run length while whipped (default 10; "
                         "Claude Code's default is 45)")
    ap.add_argument("--rules", default="",
                    help="comma-separated halls to load as system prompt, e.g. code,comms")
    ap.add_argument("--port", type=int, default=int(os.environ.get("LLM_PORT", 8080)),
                    help="8080 = llama-server (llm serve); 11434 = ollama")
    ap.add_argument("--model", default=None,
                    help="required on :11434 (ollama), e.g. qwen3-coder:30b")
    ap.add_argument("--workdir", default=os.getcwd())
    ap.add_argument("--max-steps", type=int, default=40)
    ap.add_argument("--yolo", action="store_true", help="allow arbitrary bash")
    ap.add_argument("--verify", action="store_true",
                    help="before finishing, run the project's tests (pytest / npm test). "
                         "Failures go back to the model as the next task.")
    ap.add_argument("--verify-rounds", type=int, default=2,
                    help="how many times a failing test may be sent back (default 2)")
    ap.add_argument("--no-system", action="store_true",
                    help="fold the system prompt into the first user turn. Forced on "
                         "ollama (:11434), where a system role breaks tool calling.")
    a = ap.parse_args()

    workdir = pathlib.Path(a.workdir).resolve()
    sid = f"llmagent-{uuid.uuid4().hex[:12]}"
    transcript = Transcript(sid)

    # Arm via the hook's own string match — same trigger as a Claude Code session.
    hook("start", {"session_id": sid,
                   "prompt": "whip it good" if a.whip else a.task})

    env_note = ""
    if a.whip:
        os.environ["WHIP_MIN_WORK_SECONDS"] = str(a.whip_minutes * 60)
        env_note = f"  [whipped: {a.whip_minutes} min floor]"
    print(f"session {sid}  workdir {workdir}{env_note}", file=sys.stderr)

    rules = [r for r in a.rules.split(",") if r.strip()]
    sysmsg = system_prompt(rules)

    # A `system` role SILENTLY BREAKS TOOL CALLING on ollama's qwen3-coder template:
    # the template injects the tool definitions into the system slot, so a user-supplied
    # system message displaces them and the model falls back to emitting
    # `<function=…>` as plain TEXT. The loop then sees no tool_calls, treats it as a
    # final answer, and the model cheerfully reports success for work it never did.
    # Measured 2026-11-02 — identical request, system message the only difference.
    # Folding the prompt into the first user turn keeps both the rules and the tools.
    if a.no_system or a.port == 11434:
        messages = [{"role": "user", "content": f"{sysmsg}\n\n---\n\n{a.task}"}]
    else:
        messages = [{"role": "system", "content": sysmsg},
                    {"role": "user", "content": a.task}]

    strikes = 0
    wrote_anything = [False]
    question_strike = [False]
    verify_rounds = [0]
    for step in range(a.max_steps):
        msg = chat(a.port, messages, a.model)
        messages.append(msg)

        calls = msg.get("tool_calls") or []
        if not calls:
            calls = recover_text_tool_calls(msg.get("content") or "")
            if calls:
                print(f"  (recovered {len(calls)} text-format tool call(s))",
                      file=sys.stderr)
                # Replace the text blob with the structured form so the next prompt
                # render carries a clean tool-call history.
                msg["content"] = ""
                msg["tool_calls"] = calls
        if calls:
            for c in calls:
                fn = c["function"]
                try:
                    args = json.loads(fn.get("arguments") or "{}")
                except Exception:
                    args = {}
                print(f"  → {fn['name']}({', '.join(f'{k}={str(v)[:50]!r}' for k, v in args.items())})",
                      file=sys.stderr)
                result = run_tool(fn["name"], args, workdir, a.yolo, transcript)
                if fn["name"] in WRITERS and not str(result).startswith("ERROR"):
                    wrote_anything[0] = True
                messages.append({"role": "tool", "tool_call_id": c["id"],
                                 "content": str(result)[:20000]})
            continue

        # No tool calls — the model is trying to finish. This is the Stop moment.
        reason = hook("stop", {"session_id": sid,
                               "transcript_path": str(transcript.path)})

        # The hook's work-turn test is "did it edit files", which is right for Claude
        # Code but leaves a hole here: a local model handed an explicit build task can
        # end the run by asking a clarifying question, edit nothing, and sail straight
        # through as a "conversational turn". That is the exact smoke break the whip
        # exists to stop. One forced retry, then it goes through — same one-strike
        # shape as the hook, so it can never deadlock.
        if reason is None and a.whip and not question_strike[0]:
            body = msg.get("content") or ""
            if not wrote_anything[0] and ASKED_A_QUESTION.search(body):
                question_strike[0] = True
                reason = (
                    "You ended without building anything and asked a question instead. "
                    "Do not ask — Aiden briefs in one line and expects a working V1.\n\n"
                    "Pick the most reasonable interpretation of the task, BUILD IT with "
                    "the tools now, and state your assumption in one line at the end."
                )

        # Verification gate. Runs before the whip so a genuine test failure is always
        # the next task, whipped or not — a run that ends with red tests is not done.
        if reason is None and a.verify and wrote_anything[0] \
                and verify_rounds[0] < a.verify_rounds:
            ok, label, out = run_verification(workdir)
            if label and not ok:
                verify_rounds[0] += 1
                print(f"\n✗ VERIFY ({label} failed, round {verify_rounds[0]}/"
                      f"{a.verify_rounds}) — sending the failure back\n", file=sys.stderr)
                reason = (
                    f"You said the work was done, but `{label}` FAILS. You did not run "
                    f"it.\n\n{out}\n\n"
                    "Fix the actual cause. If you changed behaviour after writing a "
                    "test, the test is now wrong — update it to match. If an import "
                    "fails, the dependency is not installed; make the test runnable "
                    "without it or note it in the README. Do not claim verification "
                    "you have not performed."
                )
            elif label and ok:
                print(f"\n✓ VERIFY ({label} passed)", file=sys.stderr)

        if reason:
            strikes += 1
            label = "asked instead of building" if question_strike[0] and strikes == 1 and not wrote_anything[0] else "under the floor"
            print(f"\n⟳ WHIP (strike {strikes}, {label}) — forced to keep going\n",
                  file=sys.stderr)
            messages.append({"role": "user", "content": reason})
            continue

        print(msg.get("content") or "(no output)")
        tail = f"[{step + 1} steps, {strikes} whip strike(s)"
        if a.verify:
            ok, label, _ = run_verification(workdir)
            tail += f", {label}: {'PASS' if ok else 'FAIL'}" if label else ", no tests found"
        print("\n" + tail + "]", file=sys.stderr)
        return

    print(f"[hit --max-steps {a.max_steps}]", file=sys.stderr)


if __name__ == "__main__":
    main()
