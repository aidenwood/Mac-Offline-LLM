#!/usr/bin/env python3
"""
llm-agent — an agentic loop over a local llama.cpp server, optionally whipped.

llama-server is a stateless completion API: no turns, no Stop event, nothing for a
Stop hook to intercept. This supplies the missing piece — a loop that has a concept
of "the model is trying to finish" — and hands that moment to Claude Code's real
whip-it-good.sh Stop hook if one is installed.

OPTIONAL. Without the hook everything else works; --whip prints a loud banner and
the final report says WHIP WAS DISABLED. It is never silently skipped.

The hook is invoked, never copied — same JSON contract (session_id +
transcript_path, event "start"/"stop") — so one file defines the rule for both
Claude Code and this loop. Override its location with $WHIP_HOOK.

--rules loads markdown rule files from $LLM_AGENT_CONTEXT/halls/<name>.md. Unset by
default; --rules without it is a hard error rather than a silent no-op.

Usage
  llm-agent "task"                        plain agentic loop
  llm-agent --whip "task"                 arm Whip-It-Good for this run
  llm-agent --whip --whip-minutes 10 "…"  shorter floor for local-model speeds
  llm-agent --verify "task"               run the project's tests before finishing
  llm-agent --rules code,comms "task"     load specific halls as system prompt
  llm-agent --port 8081 "task"            a different llama-server
  llm-agent --port 11434 --model qwen3-coder:30b "task"   via ollama (unloads when idle)

  llm-agent --chat --yolo --unrestricted --port 11434 --model qwen3-coder:30b
      long-running interactive session, full shell, writes anywhere.
      /help for in-chat commands.

Arming matches the real hook: --whip literally puts "whip it good" in the prompt the
hook sees, so the same string match that arms a Claude Code session arms this one.

Tools given to the model: list_dir, read_file, write_file, edit_file, bash.
Writes are confined to --workdir (default: cwd). bash is allowlisted unless --yolo.
"""

import argparse
import datetime as dt
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
import uuid

# ── Optional external integrations ─────────────────────────────────────────
# Both are OPTIONAL and both are absent on a fresh machine. The rule here is
# that a disabled feature must never look identical to a working one — an
# earlier version returned None silently when the hook was missing, so --whip
# ran, printed "whip on", enforced nothing, and warned nobody.

# Claude Code's Stop hook. Override with $WHIP_HOOK to point somewhere else.
HOOK = pathlib.Path(os.environ.get(
    "WHIP_HOOK", pathlib.Path.home() / ".claude" / "hooks" / "whip-it-good.sh"))
WHIP_AVAILABLE = HOOK.exists()

# A directory of rule files to load via --rules. Unset by default: this is
# personal context, not something the repo ships.
_ctx = os.environ.get("LLM_AGENT_CONTEXT", "").strip()
CONTEXT = pathlib.Path(_ctx).expanduser() if _ctx else None

HALL_ALIASES = {
    "code": "code-standards",
    "comms": "comms-and-tone",
    "git": "git-and-deploys",
    "design": "design-standards",
    "data": "data-db-safety",
    "research": "research-standards",
    "loop": "agent-loop-discipline",
    "brand": "brand-and-voice",
    "tooling": "tooling-and-estate",
}

# bash commands allowed without --yolo. Read-only / inspection only.
SAFE_BASH = re.compile(
    r"^\s*(ls|cat|head|tail|wc|grep|rg|find|file|stat|du|df|pwd|echo|which|"
    r"git\s+(status|log|diff|show|branch\s*$)|python3?\s+-c|node\s+-e|"
    r"npm\s+(run\s+(build|test|lint)|ls)|pytest|jq|sed\s+-n)\b"
)


# ─────────────────────────────── transcript ────────────────────────────────
# whip-it-good.sh decides "was this a work turn?" by counting Edit/Write tool_use
# blocks in a JSONL transcript newer than the turn's start stamp. Emit that shape.

class Transcript:
    def __init__(self, session_id):
        d = pathlib.Path("/tmp/llm-agent-transcripts")
        d.mkdir(parents=True, exist_ok=True)
        self.path = d / f"{session_id}.jsonl"
        self.path.write_text("")

    def tool_use(self, name):
        rec = {
            "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
            "message": {"content": [{"type": "tool_use", "name": name}]},
        }
        with self.path.open("a") as fh:
            fh.write(json.dumps(rec) + "\n")


# ───────────────────────────────── the hook ────────────────────────────────

def whip_banner():
    """Say loudly, once, that --whip was asked for and cannot be honoured."""
    W = 72
    # Pad by DISPLAY width, not len(): '!' is fine but an em-dash or a warning
    # sign is double-width in a terminal and silently breaks a box drawn with
    # str.ljust(). Keeping the box square is the whole point of a box.
    import unicodedata

    def disp(s):
        return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
                   for c in s)

    def row(s):
        return "│ " + s + " " * max(W - 1 - disp(s), 0) + "│"

    lines = [
        "⚠  WHIP REQUESTED BUT DISABLED",
        "",
        "The Whip-It-Good hook was not found at:",
        "  {}".format(HOOK),
        "",
        "--whip will NOT be enforced. This run stops at the first 'done'.",
        "",
        "The hook ships with Claude Code. It is optional - everything else",
        "works without it. Set $WHIP_HOOK if yours lives somewhere else.",
    ]
    print("\n┌" + "─" * W + "┐", file=sys.stderr)
    for ln in lines:
        print(row(ln), file=sys.stderr)
    print("└" + "─" * W + "┘\n", file=sys.stderr)


def hook(event, payload):
    """Call the whip-it-good.sh Stop hook. Returns its block reason, or None."""
    if not WHIP_AVAILABLE:
        return None
    try:
        p = subprocess.run(
            ["bash", str(HOOK), event],
            input=json.dumps(payload),
            capture_output=True, text=True, timeout=20,
        )
    except Exception:
        return None                       # fail open, exactly as the hook does
    out = (p.stdout or "").strip()
    if not out:
        return None
    try:
        return json.loads(out).get("reason")
    except Exception:
        return None


# ───────────────────────────────── tools ───────────────────────────────────

TOOLS = [
    {"type": "function", "function": {
        "name": "list_dir", "description": "List files in a directory.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}}, "required": ["path"]}}},
    {"type": "function", "function": {
        "name": "read_file", "description": "Read a file's contents.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}}, "required": ["path"]}}},
    {"type": "function", "function": {
        "name": "write_file", "description": "Write (or overwrite) a file.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}, "content": {"type": "string"}},
            "required": ["path", "content"]}}},
    {"type": "function", "function": {
        "name": "edit_file",
        "description": "Replace an exact string in a file. old must appear exactly once.",
        "parameters": {"type": "object", "properties": {
            "path": {"type": "string"}, "old": {"type": "string"},
            "new": {"type": "string"}}, "required": ["path", "old", "new"]}}},
    {"type": "function", "function": {
        "name": "bash", "description": "Run a shell command and return its output.",
        "parameters": {"type": "object", "properties": {
            "command": {"type": "string"}}, "required": ["command"]}}},
]

WRITERS = {"write_file", "edit_file"}

# Optional. jev adds judgement to decisions a regex can only approximate; when
# it is missing, unconfigured or offline, every call falls back to the regex
# that was here before it. Importing it must never be able to break the agent.
try:
    import importlib.machinery as _m, importlib.util as _u
    _spec = _u.spec_from_loader("jev", _m.SourceFileLoader(
        "jev", str(pathlib.Path(__file__).resolve().parent / "jev")))
    jev = _u.module_from_spec(_spec)
    _spec.loader.exec_module(jev)
except Exception:
    jev = None

# Refused even under --yolo. Not a security boundary — a local model with shell access
# can do anything it likes. This only stops the handful of commands that end the
# machine rather than the session, which a 30B has no judgement about and will
# cheerfully emit if a task description nudges it that way.
CATASTROPHIC = re.compile(
    r"(\brm\s+(-[a-zA-Z]*[rf][a-zA-Z]*\s+)+(/|~|\$HOME|/\*|\.\s*$|/Users/?\s*$)"
    r"|\bmkfs(\.|\s)|\bdiskutil\s+(erase|reformat|partition)"
    r"|\bdd\b[^|]*\bof=/dev/(disk|rdisk)"
    r"|>\s*/dev/(disk|rdisk)"
    r"|\bchmod\s+-R\s+000\s+/"
    r"|:\s*\(\s*\)\s*\{.*\|.*&.*\}\s*;?\s*:"       # fork bomb (no \b — ':' isn't a word char)
    r"|\bshutdown\b|\bhalt\b|\breboot\b"
    r"|\bkillall\s+-9\s+(kernel_task|WindowServer|launchd)"
    r"|\bsudo\s+rm\b"
    r"|\bgit\s+push\s+.*--force.*\b(main|master)\b)",
    re.I)

# "it ended by asking instead of building" — deliberately narrow so a report that
# merely contains a question mark does not trip it.
ASKED_A_QUESTION = re.compile(
    r"(could you (provide|clarify|confirm|specify)|can you (provide|clarify|confirm|specify)"
    r"|what (kind|sort|type) of|which (one|option|approach)|would you like"
    r"|do you want|let me know|please (provide|clarify|specify|confirm)"
    r"|more (details|information|context)|shall I|should I)",
    re.I)


# ─────────────────── text-format tool-call recovery ────────────────────────
# Qwen-family templates fall back to emitting tool calls as TEXT whenever the
# server's tool definitions go missing from the rendered prompt — which ollama's
# qwen3-coder template does as soon as there is `tool` role history. The loop then
# sees no tool_calls, treats it as a final answer, and the model reports success for
# work it never did. Measured 2026-11-02: step 1 structured, step 2 text.
#
# Rather than fight the template, parse the text form too. A tool call the harness
# can see is a tool call that actually runs; anything else is fiction.
#
#   <function=write_file>
#   <parameter=path>
#   hello.py
#   </parameter>
#   <parameter=content>
#   print("hi")
#   </parameter>
#   </function>

_FN_BLOCK = re.compile(r"<function=([A-Za-z0-9_]+)>(.*?)(?:</function>|\Z)", re.S)
_PARAM = re.compile(r"<parameter=([A-Za-z0-9_]+)>\n?(.*?)\n?</parameter>", re.S)


def recover_text_tool_calls(content):
    """Return OpenAI-shaped tool_calls parsed out of a text response, or []."""
    if not content or "<function=" not in content:
        return []
    out = []
    for i, m in enumerate(_FN_BLOCK.finditer(content)):
        name, body = m.group(1), m.group(2)
        args = {k: v for k, v in _PARAM.findall(body)}
        if not args:                      # also accept a bare JSON body
            try:
                args = json.loads(body.strip())
            except Exception:
                args = {}
        out.append({"id": f"recovered_{i}", "type": "function",
                    "function": {"name": name, "arguments": json.dumps(args)}})
    return out


# ────────────────────────────── verification ───────────────────────────────
# The whip makes a local model keep going. It does NOT make it correct. Measured
# 2026-11-02: a whipped run wrote test_app.py asserting the route returns
# 'Hello, World!', was pushed to keep improving, changed the route to return a
# longer string, never updated the test — then reported "all files have been
# verified and are in place". Nothing had been run.
#
# So run it. If the work produced tests, they have to pass before the run is allowed
# to finish; a failure goes back to the model as the next task.

def _have_module(name):
    """Is this module importable by the interpreter we would actually use?"""
    try:
        return subprocess.run([sys.executable, "-c", "import " + name],
                              capture_output=True, timeout=30).returncode == 0
    except Exception:
        return False


def detect_test_command(workdir):
    """Return (argv, label) for this project's tests, or None.

    Returns None when the RUNNER is missing, not just when there are no tests.
    Conflating the two is a real bug: a machine without pytest would otherwise
    see "tests failed", and --verify would send the model off to fix a failure
    that is actually a missing dependency. Stock macOS has no pytest.
    """
    has_py = (list(workdir.glob("test_*.py")) or list(workdir.glob("*_test.py"))
              or (workdir / "tests").is_dir())
    if has_py:
        if _have_module("pytest"):
            return ([sys.executable, "-m", "pytest", "-q"], "pytest")
        if _have_module("unittest"):
            return ([sys.executable, "-m", "unittest", "discover", "-q"], "unittest")
        return None                      # tests exist but nothing can run them

    pkg = workdir / "package.json"
    if pkg.exists() and shutil.which("npm"):
        try:
            if "test" in (json.loads(pkg.read_text()).get("scripts") or {}):
                return (["npm", "test", "--silent"], "npm test")
        except Exception:
            pass
    return None


def missing_runner(workdir):
    """True when tests are present but no runner is installed — worth saying."""
    has_py = (list(workdir.glob("test_*.py")) or list(workdir.glob("*_test.py"))
              or (workdir / "tests").is_dir())
    return bool(has_py) and detect_test_command(workdir) is None


# A runner that collected nothing still exits 0 and prints "Ran 0 tests ... OK".
# Counting that as a pass is worse than having no gate at all: it is a green
# light on an empty run. It fires exactly when the fallback runner is wrong for
# the project — unittest cannot collect pytest-style bare `def test_x()`
# functions — which is precisely when verification must not be claimed.
_RAN_NOTHING = re.compile(r"Ran 0 tests|no tests ran|collected 0 items", re.I)


def run_verification(workdir):
    """Run the project's tests.

    Returns (ok, label, output). **label is None means nothing was verified** —
    no tests, no runner, or a runner that collected nothing. Callers must never
    report a pass when label is None.
    """
    found = detect_test_command(workdir)
    if not found:
        return True, None, ""
    argv, label = found
    try:
        p = subprocess.run(argv, cwd=workdir, capture_output=True, text=True,
                           timeout=300)
    except Exception as e:
        return False, label, f"could not run {label}: {e}"
    out = ((p.stdout or "") + (p.stderr or ""))[-4000:]

    if _RAN_NOTHING.search(out):
        return True, None, out          # collected nothing — not a pass

    return p.returncode == 0, label, out


def run_tool(name, args, workdir, yolo, transcript, unrestricted=False):
    def resolve(p):
        q = (workdir / p).resolve() if not os.path.isabs(p) else pathlib.Path(p).resolve()
        if name in WRITERS and not unrestricted \
                and workdir not in q.parents and q != workdir:
            raise PermissionError(f"writes confined to {workdir} (--unrestricted to lift)")
        return q

    try:
        if name == "list_dir":
            q = resolve(args["path"])
            return "\n".join(sorted(x.name + ("/" if x.is_dir() else "")
                                    for x in q.iterdir())) or "(empty)"

        if name == "read_file":
            return resolve(args["path"]).read_text()[:40000]

        if name == "write_file":
            q = resolve(args["path"])
            q.parent.mkdir(parents=True, exist_ok=True)
            q.write_text(args["content"])
            transcript.tool_use("Write")
            return f"wrote {q} ({len(args['content'])} bytes)"

        if name == "edit_file":
            q = resolve(args["path"])
            s = q.read_text()
            if s.count(args["old"]) != 1:
                return f"ERROR: old string appears {s.count(args['old'])} times, need exactly 1"
            q.write_text(s.replace(args["old"], args["new"]))
            transcript.tool_use("Edit")
            return f"edited {q}"

        if name == "bash":
            cmd = args["command"]
            regex_verdict = "catastrophic" if CATASTROPHIC.search(cmd) else "safe"

            # A regex cannot read intent: `rm -rf "$BUILD_DIR"` is harmless
            # until BUILD_DIR is unset, and no pattern distinguishes those.
            # jev can, in ~150ms. It may ESCALATE what the regex waved
            # through; it can never de-escalate a pattern match, because a
            # known-bad command should not be argued out of a refusal by a
            # probabilistic model.
            verdict = regex_verdict
            if jev is not None and yolo:
                verdict, conf, used = jev.judge_command(cmd, regex_verdict)
                if used not in ("no-key", "regex-override") and verdict != regex_verdict:
                    print("  (jev: {} → {}, conf {:.2f})".format(
                        regex_verdict, verdict, conf), file=sys.stderr)

            if verdict == "catastrophic":
                return ("REFUSED: that command destroys the machine, not the session. "
                        "Refused even under --yolo. If you genuinely need it, the "
                        "operator runs it manually.")
            if not yolo and not SAFE_BASH.match(cmd):
                return ("REFUSED: not on the read-only allowlist. Re-run llm-agent "
                        "with --yolo to permit arbitrary shell, or use read_file / "
                        "write_file / edit_file instead.")
            p = subprocess.run(cmd, shell=True, cwd=workdir,
                               capture_output=True, text=True, timeout=120)
            return ((p.stdout or "") + (p.stderr or ""))[:20000] or f"(exit {p.returncode})"

    except Exception as e:
        return f"ERROR: {type(e).__name__}: {e}"
    return f"ERROR: unknown tool {name}"


# ───────────────────────────── system prompt ───────────────────────────────

BUILD_NOW = (
    "You are a coding agent running locally on this machine.\n\n"
    "NEVER ask a clarifying question. The operator briefs in one short line and "
    "expects a working V1, not a questionnaire. If the task is underspecified, "
    "choose the most "
    "reasonable interpretation, BUILD IT, and state the assumption you made in one "
    "line at the end.\n\n"
    "Use the tools. Do not describe what you would do — do it. A response that "
    "explains a plan without calling a tool is a failure.\n\n"
    "Keep working until the task is actually finished: the files exist, and anything "
    "the work obviously implies (a test, a README, the sibling file needing the same "
    "edit) is done too."
)


def system_prompt(rules):
    parts = [BUILD_NOW]
    if not rules:
        return "".join(parts)

    # --rules asked for specific rule files. If the context dir isn't configured
    # at all, that is a setup error, not something to shrug off — loading no
    # rules while reporting success is how an agent quietly stops obeying them.
    if CONTEXT is None:
        sys.exit(
            "--rules was given but $LLM_AGENT_CONTEXT is not set.\n"
            "Point it at a directory containing halls/<name>.md, e.g.\n"
            "  export LLM_AGENT_CONTEXT=~/my-rules\n"
            "…or drop --rules to run without them.")
    if not (CONTEXT / "halls").is_dir():
        sys.exit(f"$LLM_AGENT_CONTEXT is set to {CONTEXT}, but {CONTEXT}/halls "
                 "does not exist. Nothing to load.")

    missing = []
    for key in rules:
        name = HALL_ALIASES.get(key.strip(), key.strip())
        f = CONTEXT / "halls" / f"{name}.md"
        if f.exists():
            parts.append(f"\n\n# RULES — {name}\n\n{f.read_text()}")
        else:
            missing.append(name)
    if missing:
        avail = sorted(p.stem for p in (CONTEXT / "halls").glob("*.md"))
        sys.exit(f"no such rule file(s): {', '.join(missing)}\n"
                 f"available in {CONTEXT / 'halls'}: {', '.join(avail) or '(none)'}")
    return "".join(parts)



# ───────────────────────────── chat plumbing ───────────────────────────────

def approx_tokens(messages):
    """Rough token count. ~3.6 chars/token is close enough to decide when to trim."""
    return sum(len(json.dumps(m)) for m in messages) // 4


def trim(messages, limit):
    """Keep the first turn (it carries the rules) and drop the oldest middle turns.

    A long-running chat WILL overflow the context — tool output is bulky. Without
    this the backend starts truncating silently from the front, which quietly
    removes the system prompt and the rules with it.
    """
    if approx_tokens(messages) < limit * 0.75:
        return messages, 0
    head, rest = messages[:1], messages[1:]
    dropped = 0
    while rest and approx_tokens(head + rest) > limit * 0.55:
        # never orphan a tool result from its call
        rest.pop(0)
        while rest and rest[0].get("role") == "tool":
            rest.pop(0)
        dropped += 1
    return head + rest, dropped


SLASH_HELP = """commands:
  /exit /quit        leave
  /reset             clear history (keeps the rules)
  /whip [mins]       toggle whip, optionally set the floor
  /verify            toggle running tests before each answer
  /cd <path>         change the working directory
  /yolo              toggle arbitrary bash
  /tokens            show context usage
  /save <file>       write the conversation to a file
  /help              this"""

# ────────────────────────────────── loop ───────────────────────────────────

def chat(port, messages, model=None, use_tools=True):
    # Ollama (:11434) requires a "model" field; llama-server ignores it. Sending it
    # when known keeps one code path for both backends.
    body = {"messages": messages, "max_tokens": 2048}
    if model:
        body["model"] = model
    if use_tools:
        body["tools"] = TOOLS
    req = urllib.request.Request(
        f"http://localhost:{port}/v1/chat/completions",
        data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=900) as r:
            return json.load(r)["choices"][0]["message"]
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="ignore")[:300]
        if "model" in detail and port == 11434:
            sys.exit(f"ollama needs --model (e.g. --model qwen3-coder:30b)\n{detail}")
        sys.exit(f"backend error on :{port} — {detail}\n\n"
                 "If this is llama-server reporting 'Compute error', it is out of memory: "
                 "check for orphaned `llama-` processes holding models wired "
                 "(ps -Ao pid,etime,rss,args | grep llama-), or use --port 11434 "
                 "to route through ollama, which unloads idle models.")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach a server on :{port}. Start one with `llm serve <model>` "
                 f"(:8080) or `ollama serve` (:11434).  ({e})")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("task", nargs="?", default=None)
    ap.add_argument("--whip", action="store_true",
                    help="arm Whip-It-Good: refuse to finish a work run early")
    ap.add_argument("--whip-minutes", type=int, default=10,
                    help="minimum work-run length while whipped (default 10; "
                         "Claude Code's default is 45)")
    ap.add_argument("--rules", default="",
                    help="comma-separated halls to load as system prompt, e.g. code,comms")
    ap.add_argument("--port", type=int, default=int(os.environ.get("LLM_PORT", 8080)),
                    help="8080 = llama-server (llm serve); 11434 = ollama")
    ap.add_argument("--model", default=None,
                    help="required on :11434 (ollama), e.g. qwen3-coder:30b")
    ap.add_argument("--workdir", default=os.getcwd())
    ap.add_argument("--max-steps", type=int, default=40)
    ap.add_argument("--yolo", action="store_true", help="allow arbitrary bash")
    ap.add_argument("--chat", action="store_true",
                    help="interactive REPL that keeps history across turns")
    ap.add_argument("--unrestricted", action="store_true",
                    help="lift the --workdir write confinement (writes anywhere)")
    ap.add_argument("--ctx", type=int, default=32768,
                    help="model context window, used to decide when to trim history")
    ap.add_argument("--verify", action="store_true",
                    help="before finishing, run the project's tests (pytest / npm test). "
                         "Failures go back to the model as the next task.")
    ap.add_argument("--verify-rounds", type=int, default=2,
                    help="how many times a failing test may be sent back (default 2)")
    ap.add_argument("--no-system", action="store_true",
                    help="fold the system prompt into the first user turn. Forced on "
                         "ollama (:11434), where a system role breaks tool calling.")
    a = ap.parse_args()

    workdir = pathlib.Path(a.workdir).resolve()
    sid = f"llmagent-{uuid.uuid4().hex[:12]}"
    transcript = Transcript(sid)

    # Arm via the hook's own string match — same trigger as a Claude Code session.
    hook("start", {"session_id": sid,
                   "prompt": "whip it good" if a.whip else (a.task or "")})

    env_note = ""
    if a.whip:
        if WHIP_AVAILABLE:
            os.environ["WHIP_MIN_WORK_SECONDS"] = str(a.whip_minutes * 60)
            env_note = f"  [whipped: {a.whip_minutes} min floor]"
        else:
            whip_banner()
            env_note = "  [WHIP DISABLED — hook missing]"
    print(f"session {sid}  workdir {workdir}{env_note}", file=sys.stderr)

    rules = [r for r in a.rules.split(",") if r.strip()]
    sysmsg = system_prompt(rules)

    # A `system` role SILENTLY BREAKS TOOL CALLING on ollama's qwen3-coder template:
    # the template injects the tool definitions into the system slot, so a user-supplied
    # system message displaces them and the model falls back to emitting
    # `<function=…>` as plain TEXT. The loop then sees no tool_calls, treats it as a
    # final answer, and the model cheerfully reports success for work it never did.
    # Measured 2026-11-02 — identical request, system message the only difference.
    # Folding the prompt into the first user turn keeps both the rules and the tools.
    fold = a.no_system or a.port == 11434

    if a.chat and not a.task:
        # Seed the rules as a completed exchange so there is a stable head for trim()
        # to preserve, and the first thing the user types is a normal turn.
        if fold:
            messages = [{"role": "user", "content": sysmsg},
                        {"role": "assistant", "content": "Understood. Ready."}]
        else:
            messages = [{"role": "system", "content": sysmsg}]
    elif fold:
        messages = [{"role": "user", "content": f"{sysmsg}\n\n---\n\n{a.task}"}]
    else:
        messages = [{"role": "system", "content": sysmsg},
                    {"role": "user", "content": a.task}]

    if not a.chat and not a.task:
        sys.exit("nothing to do: give a task, or use --chat for an interactive session.")

    state = {"workdir": workdir, "sid": sid, "transcript": transcript}

    if a.chat:
        return chat_repl(a, messages, state)

    run_turn(a, messages, state)


def run_turn(a, messages, state):
    """One agentic turn: loop tools until the model finishes and the gates allow it."""
    workdir, sid, transcript = state["workdir"], state["sid"], state["transcript"]
    strikes = 0
    wrote_anything = [False]
    question_strike = [False]
    verify_rounds = [0]

    for step in range(a.max_steps):
        msg = chat(a.port, messages, a.model)
        messages.append(msg)

        calls = msg.get("tool_calls") or []
        if not calls:
            calls = recover_text_tool_calls(msg.get("content") or "")
            if calls:
                print(f"  (recovered {len(calls)} text-format tool call(s))",
                      file=sys.stderr)
                # Replace the text blob with the structured form so the next prompt
                # render carries a clean tool-call history.
                msg["content"] = ""
                msg["tool_calls"] = calls
        if calls:
            for c in calls:
                fn = c["function"]
                try:
                    args = json.loads(fn.get("arguments") or "{}")
                except Exception:
                    args = {}
                shown = ", ".join(f"{k}={str(v)[:50]!r}" for k, v in args.items())
                print(f"  \u2192 {fn['name']}({shown})", file=sys.stderr)
                result = run_tool(fn["name"], args, state["workdir"], a.yolo,
                                  transcript, a.unrestricted)
                if fn["name"] in WRITERS and not str(result).startswith("ERROR"):
                    wrote_anything[0] = True
                messages.append({"role": "tool", "tool_call_id": c["id"],
                                 "content": str(result)[:20000]})
            continue

        # No tool calls — the model is trying to finish. This is the Stop moment.
        reason = hook("stop", {"session_id": sid,
                               "transcript_path": str(transcript.path)})

        # The hook's work-turn test is "did it edit files", which is right for Claude
        # Code but leaves a hole here: a local model handed an explicit build task can
        # end the run by asking a clarifying question, edit nothing, and sail straight
        # through as a "conversational turn". One forced retry, then it goes through.
        if reason is None and a.whip and not question_strike[0]:
            body = msg.get("content") or ""
            asked = bool(ASKED_A_QUESTION.search(body))

            # The regex is a phrase list; it cannot tell "finished a small job"
            # from "gave up". jev decides between finished/asked/partial/
            # blocked, which is the judgement the phrase list was always
            # approximating. Falls back to the regex verdict when unavailable.
            if jev is not None and not wrote_anything[0]:
                verdict, conf, used = jev.judge_finished(body[:2000], asked)
                if used not in ("no-key",):
                    asked = verdict in ("asked", "partial")
                    if verdict == "blocked":
                        asked = False      # genuinely stuck is not a smoke break

            if not wrote_anything[0] and asked:
                question_strike[0] = True
                reason = (
                    "You ended without building anything and asked a question instead. "
                    "Do not ask — the operator briefs in one line and expects a "
                    "working V1.\n\n"
                    "Pick the most reasonable interpretation of the task, BUILD IT with "
                    "the tools now, and state your assumption in one line at the end."
                )

        # Verification gate. Runs before the whip so a genuine test failure is always
        # the next task, whipped or not — a run that ends with red tests is not done.
        if reason is None and a.verify and wrote_anything[0] \
                and verify_rounds[0] < a.verify_rounds:
            ok, label, out = run_verification(state["workdir"])
            if label and not ok:
                verify_rounds[0] += 1
                print(f"\n\u2717 VERIFY ({label} failed, round {verify_rounds[0]}/"
                      f"{a.verify_rounds}) — sending the failure back\n", file=sys.stderr)
                reason = (
                    f"You said the work was done, but `{label}` FAILS. You did not run "
                    f"it.\n\n{out}\n\n"
                    "Fix the actual cause. If you changed behaviour after writing a "
                    "test, the test is now wrong — update it to match. If an import "
                    "fails, the dependency is not installed; make the test runnable "
                    "without it or note it in the README. Do not claim verification "
                    "you have not performed."
                )
            elif label and ok:
                print(f"\n\u2713 VERIFY ({label} passed)", file=sys.stderr)
            elif missing_runner(state["workdir"]):
                print("\n\u26a0 VERIFY: tests exist but no runner is installed "
                      "(pip install pytest) — not verified", file=sys.stderr)
            elif out:
                # A runner ran and collected nothing. Never silent: an empty
                # green run is the most misleading result available.
                print("\n\u26a0 VERIFY: the test runner collected nothing — "
                      "NOT verified", file=sys.stderr)

        if reason:
            strikes += 1
            why = ("asked instead of building"
                   if question_strike[0] and strikes == 1 and not wrote_anything[0]
                   else "under the floor")
            print(f"\n\u27f3 WHIP (strike {strikes}, {why}) — forced to keep going\n",
                  file=sys.stderr)
            messages.append({"role": "user", "content": reason})
            continue

        print(msg.get("content") or "(no output)")
        whip_note = (" whip strike(s)" if WHIP_AVAILABLE or not a.whip
                     else " whip strike(s) — WHIP WAS DISABLED (hook missing)")
        tail = f"[{step + 1} steps, {strikes}{whip_note}"
        if a.verify:
            ok, label, output = run_verification(state["workdir"])
            if label:
                tail += ", {}: {}".format(label, "PASS" if ok else "FAIL")
            elif missing_runner(state["workdir"]):
                tail += ", tests present but NO RUNNER (pip install pytest)"
            elif output:
                # label is None but a runner DID produce output — it ran and
                # collected nothing. Distinct from "no tests exist".
                tail += ", runner collected NOTHING (not verified)"
            else:
                tail += ", no tests found"
        print("\n" + tail + "]", file=sys.stderr)
        return

    print(f"[hit --max-steps {a.max_steps}]", file=sys.stderr)


def chat_repl(a, messages, state):
    """Long-running interactive chat. History persists; context is trimmed, not dropped."""
    log = pathlib.Path("/tmp/llm-agent-transcripts") / f"{state['sid']}.chat.md"
    print(f"\n  model     {a.model or 'llama-server'}  on :{a.port}")
    print(f"  workdir   {state['workdir']}"
          f"{'  (UNRESTRICTED — writes anywhere)' if a.unrestricted else ''}")
    print(f"  bash      {'UNRESTRICTED' if a.yolo else 'read-only allowlist'}"
          "   (machine-destroying commands always refused)")
    print(f"  whip      {'on, ' + str(a.whip_minutes) + ' min floor' if a.whip else 'off'}"
          f"    verify  {'on' if a.verify else 'off'}")
    print(f"  log       {log}")
    print("  /help for commands, /exit to leave\n")

    while True:
        try:
            line = input("\033[1m›\033[0m ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nbye")
            return
        if not line:
            continue

        if line.startswith("/"):
            cmd, _, arg = line[1:].partition(" ")
            cmd, arg = cmd.lower(), arg.strip()
            if cmd in ("exit", "quit", "q"):
                print("bye")
                return
            if cmd == "help":
                print(SLASH_HELP)
            elif cmd == "reset":
                del messages[1:]
                print("  history cleared (rules kept)")
            elif cmd == "whip":
                if arg.isdigit():
                    a.whip_minutes = int(arg)
                a.whip = not a.whip if not arg.isdigit() else True
                os.environ["WHIP_MIN_WORK_SECONDS"] = str(a.whip_minutes * 60)
                armed = pathlib.Path(f"/tmp/.whip-on-{state['sid']}")
                armed.touch() if a.whip else armed.unlink(missing_ok=True)
                print(f"  whip {'on, ' + str(a.whip_minutes) + ' min floor' if a.whip else 'off'}")
            elif cmd == "verify":
                a.verify = not a.verify
                print(f"  verify {'on' if a.verify else 'off'}")
            elif cmd == "yolo":
                a.yolo = not a.yolo
                print(f"  bash {'UNRESTRICTED' if a.yolo else 'read-only allowlist'}")
            elif cmd == "cd":
                q = pathlib.Path(arg).expanduser().resolve()
                if q.is_dir():
                    state["workdir"] = q
                    print(f"  workdir {q}")
                else:
                    print(f"  no such directory: {q}")
            elif cmd == "tokens":
                n = approx_tokens(messages)
                print(f"  ~{n} / {a.ctx} tokens ({100 * n // max(a.ctx, 1)}%), "
                      f"{len(messages)} messages")
            elif cmd == "save":
                dst = pathlib.Path(arg or "conversation.md").expanduser()
                dst.write_text(log.read_text() if log.exists() else "")
                print(f"  saved {dst}")
            else:
                print(f"  unknown command /{cmd} — /help")
            continue

        messages.append({"role": "user", "content": line})
        messages[:], dropped = trim(messages, a.ctx)
        if dropped:
            print(f"  (trimmed {dropped} old turn(s) to stay inside {a.ctx} ctx)",
                  file=sys.stderr)

        # Each chat turn is its own whip turn — restamp so the floor measures THIS
        # turn, not the whole session. Otherwise a long session silently satisfies
        # the floor and the whip stops meaning anything.
        hook("start", {"session_id": state["sid"],
                       "prompt": "whip it good" if a.whip else line})
        state["transcript"] = Transcript(state["sid"])

        try:
            run_turn(a, messages, state)
        except SystemExit:
            raise
        except Exception as e:
            print(f"  error: {type(e).__name__}: {e}", file=sys.stderr)

        with log.open("a") as fh:
            fh.write(f"\n## › {line}\n\n")
            last = messages[-1].get("content") if messages else ""
            fh.write((last or "") + "\n")


if __name__ == "__main__":
    main()
