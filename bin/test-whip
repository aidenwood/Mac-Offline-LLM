#!/usr/bin/env python3
"""
test-whip — prove llm-agent's Whip-It-Good wiring without needing a loaded model.

The whip decision depends only on (armed?, elapsed, did-it-edit?), all of which live
in the hook. So the integration can be tested by driving the hook through the same
code path llm-agent uses, with a synthetic transcript.

Run:  test-whip
"""
import importlib.machinery
import importlib.util
import os
import pathlib
import sys
import time
import uuid

HERE = pathlib.Path(__file__).resolve().parent
# llm-agent has no .py suffix, so the loader must be named explicitly.
spec = importlib.util.spec_from_loader(
    "llm_agent",
    importlib.machinery.SourceFileLoader("llm_agent", str(HERE / "llm-agent")))
agent = importlib.util.module_from_spec(spec)
sys.argv = ["llm-agent", "noop"]           # module parses args only under __main__
spec.loader.exec_module(agent)

PASS, FAIL = "\033[32mPASS\033[0m", "\033[31mFAIL\033[0m"
SKIP = "\033[33mSKIP\033[0m"
results = []

# Written as unittest.TestCase so that BOTH pytest and unittest can collect
# them. A bare `def test_x()` is a pytest idiom; unittest silently collects
# nothing from it, which is the trap these very tests exist to catch.
PASSING_TEST = """import unittest


class T(unittest.TestCase):
    def test_passes(self):
        self.assertEqual(1 + 1, 2)
"""

FAILING_TEST = """import unittest

from app import greet


class T(unittest.TestCase):
    def test_greeting(self):
        self.assertEqual(greet(), 'Hello, World!')
"""

# The whip hook is OPTIONAL. Without it those cases are untestable, not failing —
# reporting FAIL for a feature the user never installed is a guard crying wolf.
HAVE_HOOK = agent.WHIP_AVAILABLE


def case(name, armed, edits, elapsed_s, floor_min, expect_block):
    if not HAVE_HOOK:
        print(f"  {SKIP}  {name}")
        print(f"        whip hook not installed at {agent.HOOK}")
        return
    sid = f"test-{uuid.uuid4().hex[:8]}"
    os.environ["WHIP_MIN_WORK_SECONDS"] = str(floor_min * 60)

    # arm (or not) exactly the way llm-agent does — via the hook's own string match
    agent.hook("start", {"session_id": sid,
                         "prompt": "whip it good" if armed else "just do the thing"})

    # backdate the start stamp to simulate a run of `elapsed_s`
    stamp = pathlib.Path(f"/tmp/.whip-start-{sid}")
    stamp.write_text(str(int(time.time()) - elapsed_s))

    t = agent.Transcript(sid)
    for _ in range(edits):
        t.tool_use("Write")

    reason = agent.hook("stop", {"session_id": sid, "transcript_path": str(t.path)})
    blocked = reason is not None
    ok = blocked == expect_block
    results.append(ok)
    print(f"  {PASS if ok else FAIL}  {name}")
    print(f"        armed={armed} edits={edits} elapsed={elapsed_s}s floor={floor_min}m "
          f"→ {'BLOCKED' if blocked else 'allowed'} (expected "
          f"{'BLOCKED' if expect_block else 'allowed'})")
    for f in (stamp, pathlib.Path(f"/tmp/.whip-on-{sid}"),
              pathlib.Path(f"/tmp/.whip-strike-{sid}"), t.path):
        f.unlink(missing_ok=True)


def strike_case():
    """Second stop in the same run must always be allowed — one-strike, never a cage."""
    if not HAVE_HOOK:
        print(f"  {SKIP}  one-strike only: 2nd stop always goes through")
        print(f"        whip hook not installed at {agent.HOOK}")
        return
    sid = f"test-{uuid.uuid4().hex[:8]}"
    os.environ["WHIP_MIN_WORK_SECONDS"] = "600"
    agent.hook("start", {"session_id": sid, "prompt": "whip it good"})
    pathlib.Path(f"/tmp/.whip-start-{sid}").write_text(str(int(time.time()) - 10))
    t = agent.Transcript(sid)
    t.tool_use("Write")
    first = agent.hook("stop", {"session_id": sid, "transcript_path": str(t.path)})
    second = agent.hook("stop", {"session_id": sid, "transcript_path": str(t.path)})
    ok = first is not None and second is None
    results.append(ok)
    print(f"  {PASS if ok else FAIL}  one-strike only: 2nd stop always goes through")
    print(f"        1st={'BLOCKED' if first else 'allowed'}  "
          f"2nd={'BLOCKED' if second else 'allowed'}  (expected BLOCKED then allowed)")


def verify_cases():
    """The --verify gate: red tests must be detected and surfaced, not assumed."""
    print("verify:")
    import shutil
    import tempfile

    probe = pathlib.Path(tempfile.mkdtemp(prefix="probe-"))
    (probe / "test_x.py").write_text(PASSING_TEST)
    found = agent.detect_test_command(probe)
    shutil.rmtree(probe, ignore_errors=True)

    if found is None:
        # No runner at all. The cases are untestable, but the DISTINCTION
        # between "no runner" and "tests failed" still is, and it is the whole
        # point — otherwise --verify sends the model to fix a missing dep.
        for name in ("no tests found -> allowed", "passing tests -> allowed",
                     "code changed under its test -> BLOCKED"):
            print(f"  {SKIP}  {name}")
            print("        no test runner installed (pip install pytest)")
        d = pathlib.Path(tempfile.mkdtemp(prefix="norunner-"))
        (d / "test_x.py").write_text(PASSING_TEST)
        r = agent.missing_runner(d)
        results.append(r)
        print(f"  {PASS if r else FAIL}  tests present + no runner -> reported "
              f"as 'no runner', not 'failed'")
        shutil.rmtree(d, ignore_errors=True)
        return

    label_expected = found[1]
    print(f"        runner: {label_expected}")
    root = pathlib.Path(tempfile.mkdtemp(prefix="verify-"))

    # 1. no tests at all -> nothing to gate on
    ok, label, _ = agent.run_verification(root)
    r1 = ok and label is None
    results.append(r1)
    print(f"  {PASS if r1 else FAIL}  no tests found -> run is allowed through")

    # 2. a passing test -> allowed, and named by whichever runner was chosen
    (root / "test_ok.py").write_text(PASSING_TEST)
    ok, label, out = agent.run_verification(root)
    r2 = ok and label == label_expected
    results.append(r2)
    print(f"  {PASS if r2 else FAIL}  passing tests -> allowed  "
          f"(label={label}, expected {label_expected})")

    # 3. the failure seen in the wild: code changed out from under its own test
    (root / "app.py").write_text("def greet():\n    return 'Hello, World! Welcome.'\n")
    (root / "test_ok.py").write_text(FAILING_TEST)
    ok, label, out = agent.run_verification(root)
    r3 = (not ok) and label == label_expected
    results.append(r3)
    print(f"  {PASS if r3 else FAIL}  code changed under its test -> BLOCKED "
          f"({len(out)} chars captured)")

    # 4. a runner that collects NOTHING must not report a pass. Claiming green
    #    on an empty run is worse than having no gate.
    empty = pathlib.Path(tempfile.mkdtemp(prefix="empty-"))
    (empty / "test_uncollectable.py").write_text(
        "# deliberately contains no test this runner can collect\n"
        "def helper():\n    return 1\n")
    ok, label, out = agent.run_verification(empty)
    r4 = label is None
    results.append(r4)
    print(f"  {PASS if r4 else FAIL}  runner collected nothing -> NOT counted "
          f"as a pass (label={label})")
    shutil.rmtree(empty, ignore_errors=True)

    shutil.rmtree(root, ignore_errors=True)


def trim_cases():
    """trim() must protect the rules head and never orphan a tool result."""
    print("trim:")

    head = {"role": "user", "content": "RULES: never fork a source of truth. " + "x" * 400}

    # 1. a short conversation is left completely alone
    short = [head, {"role": "user", "content": "hi"},
             {"role": "assistant", "content": "hello"}]
    out, dropped = agent.trim(list(short), 32768)
    r1 = dropped == 0 and out == short
    results.append(r1)
    print(f"  {PASS if r1 else FAIL}  short conversation untouched (dropped={dropped})")

    # 2. an overflowing conversation is trimmed, and the rules head SURVIVES
    big = [head]
    for i in range(400):
        big.append({"role": "user", "content": f"turn {i} " + "y" * 600})
        big.append({"role": "assistant", "content": f"reply {i} " + "z" * 600})
    before = agent.approx_tokens(big)
    out, dropped = agent.trim(list(big), 8192)
    after = agent.approx_tokens(out)
    r2 = dropped > 0 and out[0] == head and after < before
    results.append(r2)
    print(f"  {PASS if r2 else FAIL}  overflow trimmed, rules head kept "
          f"({before}→{after} tok, dropped {dropped})")

    # 3. it actually gets under the window it was given
    r3 = after < 8192
    results.append(r3)
    print(f"  {PASS if r3 else FAIL}  result fits the context window "
          f"({after} < 8192)")

    # 4. no orphaned tool results — every `tool` msg still follows an assistant
    convo = [head]
    for i in range(300):
        convo.append({"role": "assistant", "content": "", "tool_calls": [
            {"id": f"c{i}", "type": "function",
             "function": {"name": "read_file", "arguments": "{}"}}]})
        convo.append({"role": "tool", "tool_call_id": f"c{i}",
                      "content": "w" * 800})
    out, _ = agent.trim(list(convo), 8192)
    orphan = any(m.get("role") == "tool" and
                 (i == 0 or out[i - 1].get("role") != "assistant")
                 for i, m in enumerate(out))
    r4 = not orphan
    results.append(r4)
    print(f"  {PASS if r4 else FAIL}  no tool result orphaned from its call")


print(f"hook: {agent.HOOK}")
print("exists: {}{}\n".format(
    HAVE_HOOK,
    "" if HAVE_HOOK else "   → whip cases will SKIP (optional feature)"))

print("whip:")
case("unarmed work run stays out of the way",   False, 3, 10,   45, False)
case("armed + edited + under floor  → blocked", True,  3, 10,   10, True)
case("armed + edited + over floor   → allowed", True,  3, 4000, 10, False)
case("armed but no edits (chat turn) → allowed", True, 0, 10,   10, False)
strike_case()
print()
verify_cases()
print()
trim_cases()

skipped = "" if HAVE_HOOK else "  (whip cases skipped — hook not installed)"
print(f"\n{sum(results)}/{len(results)} passed{skipped}")
sys.exit(0 if all(results) else 1)
